# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=veyra_user
DB_PASSWORD=change_me
DB_NAME=veyra_db
DB_CONNECTION_LIMIT=10

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Seed admin (used only by db/seed.sql instructions / optional seed script)
SEED_ADMIN_EMAIL=admin@veyra.local
SEED_ADMIN_PASSWORD=change_this_before_seeding
